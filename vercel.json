{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{real_time_data.enc,real time data/**,models/ResNet50/**,results/**,docs/**,scratch/**,test*/**,*.docx,*.md}"
    }
  }
}
